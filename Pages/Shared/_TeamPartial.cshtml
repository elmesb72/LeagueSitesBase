@model TeamModel
<div class="row">
    <div class="section team-header">
        <style>
            .team-header {
                background-color: #@(Model.Team!.BackgroundColor); 
                color: #@(Model.Team.Color);
            }
        </style>
        <div class="team-header-logo"><img src="/images/teams/@(Model.Team.ID)-lg.webp" onerror="this.style.display='none'"></div>
        <div class="team-header-main">
            <p class="team-header-details">@Model.Team.Location @Model.Team.Name</p>
    @{
        var standings = new Standings(Model.Schedule?.Games ?? []);
    }
    @if (standings.ContainsKey(Model.Team!)) {
            <p class="team-header-record">@(standings[Model.Team].ToString())</p>
    }
    else {
            <p class="team-header-record">(0-0)</p>
    }
            <p class="team-header-manager">Manager: @(Model.Managers.Count > 0 ? String.Join(", ", Model.Managers) : "(Unknown)")</p>
        </div>
    </div>
</div>
<div class="row team-main">
    <div class="section team-schedule">
        <h1>Schedule</h1>
        <div class="subsection">
            <partial name="_CalendarPartial" model="Model.Schedule" />
        </div>
    </div>
    <div class="section team-roster">
        <div class="subsection team-roster-active">
            <h1>
                Active Roster
    @if(Model.Permissions.Any(p => new List<String>() { "Scorer", "Manager", "Webmaster" }.Contains(p))) {
                <a href="/Invitation"><i title="Add" class="fas fa-user-plus header-icon"></i></a>
    }
            </h1>
            @await Html.PartialAsync("_TeamRosterListPartial", new RosterPartialModel() { Invitations  = Model.ActiveRoster, Permissions = Model.Permissions })
        </div>
    @if(Model.Permissions.Any(p => new List<String>() { "Team", "League Executive", "Webmaster" }.Contains(p))) {
        <div class="subsection team-roster-inactive">
            <h1>Inactive Roster</h1>
            <h2>
                Substitutes
        @if(Model.Permissions.Any(p => new List<String>() { "Scorer", "Manager", "Webmaster" }.Contains(p))) {
                <a href="/Invitation"><i title="Add" class="fas fa-user-plus header-icon"></i></a>
        }
            </h2>
            @await Html.PartialAsync("_TeamRosterListPartial", new RosterPartialModel() { Invitations = Model.Substitutes, Permissions = Model.Permissions })
        @if(Model.FormerPlayers.Count > 0) {
            <h2>Former Players</h2>
            @await Html.PartialAsync("_TeamRosterListPartial", new RosterPartialModel() { Invitations = Model.FormerPlayers, Permissions = Model.Permissions })
        }
            <h2>
                Non-Player Users
        @if(Model.Permissions.Any(p => new List<String>() { "Scorer", "Manager", "League Executive", "Webmaster" }.Contains(p))) {
                <a href="/Invitation"><i title="Add" class="fas fa-user-plus header-icon"></i></a>
        }
            </h2>
            @await Html.PartialAsync("_TeamRosterListPartial", new RosterPartialModel() { Invitations = Model.NonPlayerUsers, Permissions = Model.Permissions })
        </div>
    }
    </div>
</div>
    @if(Model.Permissions.Any(p => p == "Team")) {
<div class="row team-stats">
    <div class="section">
        <h1>Stats</h1>
        <div class="section-row">
            <h2>Batting</h2>
            <div class="subsection">
                <i title="Coming Soon" class="fas fa-laptop-code"></i> Coming Soon
            </div>
        </div>
        <div class="section-row">
            <h2>Pitching</h2>
            <div class="subsection">
                <i title="Coming Soon" class="fas fa-laptop-code"></i> Coming Soon
            </div>
        </div>
    </div>
</div>
    }
    @if(Model.Permissions.Any(p => new List<String>() { "Scorer", "Manager", "League Executive", "Webmaster" }.Contains(p))) {
<form method="post" id="team-edit-form">
<div class="row team-edit">
    <div class="section">
        <div class="section-row">
            <h1>Edit Team Info</h1>
        </div>
        <div class="section-row">
            <div class="subsection team-edit-basic">
                <h2>Basic Details</h2>
                <div class="section-row">
                    <div class="form-field">
                        <label for="Location">Location</label>
                        <input type="text" id="Location" asp-for="Form!.Location" />
                    </div>
                    <div class="form-field">
                        <label for="Name">Name</label>
                        <input type="text" id="Name" asp-for="Form!.Name" />
                    </div>
                    <div>
                        <label for="Abbr">Abbreviation</label>
                        <input type="text" id="Abbr" asp-for="Form!.Abbreviation" />
                    </div>
                </div>
            </div>
            <div class="subsection">
                <h2>Customization</h2>
                <div class="section-row">
                    <div class="form-field">
                        <label for="BackgroundColor">Background</label>
                        <input type="text" class="jscolor"  id="BackgroundColor" asp-for="Form!.BackgroundColor" 
                            data-jscolor="{borderColor:'#FFF', insetColor:'#FFF', backgroundColor:'#666', onFineChange:'updateBG(this)'}" />
                    </div>
                    <div>
                        <label for="TextColor">Text</label>
                        <input type="text" class="jscolor"  id="TextColor" asp-for="Form!.Color" 
                            data-jscolor="{borderColor:'#FFF', insetColor:'#FFF', backgroundColor:'#666', onFineChange:'updateColor(this)'}" />
                    </div>
                </div>
            </div>
        </div>
        <div class="section-row submit-row">
            <button type="submit">Update</button>
        </div>
        <div class="section-row" id="error-text"></div>
    </div>
</div>
</form>
    }
<script src="https://code.jquery.com/jquery-3.5.0.min.js" integrity="sha256-xNzN2a4ltkB44Mc/Jz3pT4iU1cmeR0FkXs4pru/JxaQ=" crossorigin="anonymous"></script>
<script src="~/js/jquery.unobtrusive-ajax.js" asp-append-version="true"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.1/dist/jquery.validate.min.js"></script>
<script src="~/js/jscolor.js" asp-append-version="true"></script><!-- http://jscolor.com/ -->
<script src="~/js/team.js" asp-append-version="true"></script>