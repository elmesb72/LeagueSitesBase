@model Standings
<table class="standings">
            <tr>
                <th>Team</th>
                <th>GP</th>
                <th>W</th>
                <th>L</th>
                <th>T</th>
                <th>Pts</th>
                <th>RF</th>
                <th>RA</th>
                <th>Diff</th>
                <th>Home</th>
                <th>Away</th>
                <th>Strk</th>
            </tr>
@foreach(var t in Model) 
{
            <tr>
                <td><a href="/Team/@t.Key.Abbreviation" class="standings-link"><partial name="_TeamLogoSmall" model="t.Key" /></a></td>
                <td>@t.Value.GamesPlayed</td>
                <td>@t.Value.Wins</td>
                <td>@t.Value.Losses</td>
                <td>@t.Value.Ties</td>
                <td>@t.Value.Points</td>
                <td>@t.Value.RunsScored</td>
                <td>@t.Value.RunsAllowed</td>
    @if(t.Value.RunDifferential > 0)
    {
                <td class="green">+@t.Value.RunDifferential</td>
    }
    else if (t.Value.RunDifferential == 0)
    {
                <td>0</td>
    }
    else if (t.Value.RunDifferential < 0)
    {
                <td class="red">@t.Value.RunDifferential</td>
    }
                <td>
    @{
        var homeRecord = t.Value.Results.Where(r => r.WasHome);
    }
                    @(homeRecord.Count(r => r.Result == GameResult.Win))-@(homeRecord.Count(r => r.Result == GameResult.Loss))-@(homeRecord.Count(r => r.Result == GameResult.Tie))
                </td>
                <td>
    @{
        var awayRecord = t.Value.Results.Where(r => !r.WasHome);
    }
                    @(awayRecord.Count(r => r.Result == GameResult.Win))-@(awayRecord.Count(r => r.Result == GameResult.Loss))-@(awayRecord.Count(r => r.Result == GameResult.Tie))
                </td>
                <td>
                    @(t.Value.Streak)
                </td>
            </tr>
}
        </table>