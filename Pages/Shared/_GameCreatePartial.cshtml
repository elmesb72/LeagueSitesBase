@inject LeagueSitesContext dbContext
@model GameModel
<form name="EditGameForm" method="post">
<input type="hidden" id="game-id" name="Game.ID" value="@(Model.Game!.ID)" />

<div class="row game-row">
    <div class="inner-row">
        <div class="section game-team">
            <div><img src="/images/teams/10-md.webp"></div>
        </div>
        <div class="section game-header">
            <div class="game-season">
                @Html.DropDownListFor(
                    m => m.Game!.SeasonID,
                    new SelectList(
                        dbContext.Seasons.OrderByDescending(x => x.StartDate),
                        "ID",
                        "Name",
                        Model.Game.SeasonID
                    )
                )
            </div>
            <div class="game-matchup">
                @Html.DropDownListFor(
                    m => m.Game!.VisitingTeamID,
                    new SelectList(
                        dbContext.Teams.Where(t => t.Active).OrderBy(x => x.Abbreviation),
                        "ID",
                        "FullName",
                        Model.Game.VisitingTeamID
                    )
                ) 
                @@ 
                @Html.DropDownListFor(
                    m => m.Game!.HostTeamID,
                    new SelectList(
                        dbContext.Teams.Where(t => t.Active).OrderBy(x => x.Abbreviation),
                        "ID",
                        "FullName",
                        Model.Game.HostTeamID
                    )
                )
            </div>
            <div class="game-time">
                @Html.TextBoxFor(m => m.Game!.Date, "{0:yyyy-MM-dd h:mm tt}")
            </div>
            <div class="game-location">
                @Html.DropDownListFor(
                    m => m.Game!.LocationID,
                    new SelectList(
                        dbContext.Locations.OrderByDescending(x => x.Active).ThenBy(x => x.Name),
                        "ID",
                        "Name",
                        Model.Game.LocationID
                    )
                )
            </div>
        </div>
        <div class="section game-team">
            <div><img src="/images/teams/10-md.webp"></div>
        </div>
    </div>
    <div class="inner-row">
        <div class="section game-team">
            <input type="hidden" id="score-visitor-orig" value="@(Model.Game.ScoreVisitor)" />
            <input type="text" tabindex="1000" placeholder="0" width=100 name="Game.ScoreVisitor" id="score-visitor" value="@(Model.Game.ScoreVisitor)" onchange="updateScore(this, 'visitor')" />
        </div>
        <div class="section game-header">
        @foreach(var status in dbContext.GameStatuses) {
            <input type="radio" name="Game.StatusID" id="game-status-id-@(status.Name)" value="@(status.ID)" onclick="updateGameStatus(this)" @Html.Raw(Model.Game.StatusID == status.ID ? "checked" : String.Empty)> <label for="game-status-id-@(status.Name)">@(status.Name)</label>
        }
        </div>
        <div class="section game-team">
            <input type="hidden" id="score-host-orig" value="@(Model.Game.ScoreHost)" />
            <input type="text" tabindex="1001" placeholder="0" width=100 name="Game.ScoreHost" id="score-host" value="@(Model.Game.ScoreHost)" onchange="updateScore(this, 'host')" /></p>
        </div>

    </div>
    <div class="inner-row">
        <div class="section">
            <input type="submit" tabindex="1002"  name="CreateDetails" value="Create" />
        </div>
    </div>
</div>
