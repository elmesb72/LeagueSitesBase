@model Schedule
<div class="schedule desktop-only">
    <table cellpadding=0 cellspacing=0>
            <tr>
                <th>Date</th>
                <th>Time</th>
                <th>Location</th>
                <th>Home</th>
                <th>Visitor</th>
                <th>Result</th>
            </tr>
            @foreach (var g in Model.Games)
            {
                <tr>
                    <td><a href="/Game/@(g.ID)">@(g.Date.ToString("dddd, MMM d"))</a></td>
                    <td><a href="/Game/@(g.ID)">@(g.Date.ToString("h:mm tt"))</a></td>
                    <td><a href="/Locations/#@(g.Location?.Name)">@(g.Location?.Name)</a></td>
                @if(Model.FocusTeam == g.HostTeam)
                {
                    <td class="soft"><span>@(g.HostTeam?.Name)</span></td>
                }
                else
                {
                    <td><a href="/Team/@(g.HostTeam?.Abbreviation)">@(g.HostTeam?.Name)</td>
                }
                @if(Model.FocusTeam == g.VisitingTeam)
                {
                    <td class="soft"><span>@(g.VisitingTeam?.Name)</span></td>
                }
                else
                {
                    <td><a href="/Team/@(g.VisitingTeam?.Abbreviation)">@(g.VisitingTeam?.Name)</td>
                }
                    <td class="schedule-result">
                @if(g.Status?.Name == "Played") {
                        <a href="/Game/@g.ID">
                    @if (Model.FocusTeam == null)
                    {
                            <span>@g.ScoreHost - @g.ScoreVisitor</span>
                    }
                    else
                    {
                        @if (Model.FocusTeam == g.HostTeam)
                        {
                            @if(g.ScoreHost > g.ScoreVisitor)
                            {
                            <span>W, @g.ScoreHost-@g.ScoreVisitor</span>
                            }
                            else if(g.ScoreHost < g.ScoreVisitor)
                            {
                            <span>L, @g.ScoreVisitor-@g.ScoreHost</span>
                            }
                            else
                            {
                            <span>T, @g.ScoreHost-@g.ScoreVisitor</span>
                            }
                        }
                        else if (Model.FocusTeam == g.VisitingTeam)
                        {
                            @if(g.ScoreVisitor > g.ScoreHost)
                            {
                            <span>W, @g.ScoreVisitor-@g.ScoreHost</span>
                            }
                            else if(g.ScoreVisitor < g.ScoreHost)
                            {
                            <span>L, @g.ScoreHost-@g.ScoreVisitor</span>
                            }
                            else
                            {
                            <span>T, @g.ScoreHost-@g.ScoreVisitor</span>
                            }
                        }
                        else // Focus team was not playing in this game
                        {
                            <span>@g.ScoreHost - @g.ScoreVisitor</span>
                        }
                        
                    }
                        </a>
                }
                else if (g.Status?.Name == "Upcoming") { }
                else if (g.Status?.Name == "Forfeit (Home)")
                {
                    if (g.HostTeam == Model.FocusTeam)
                    {
                        <a href="/Game/@(g.ID)" title="Forfeit Loss">FL, 7-0</a>
                    }
                    else
                    {
                        <a href="/Game/@(g.ID)" title="Forfeit Win">FW, 7-0</a>
                    }
                }
                else if (g.Status?.Name == "Forfeit (Away)")
                {
                    if (g.VisitingTeam == Model.FocusTeam)
                    {
                        <a href="/Game/@(g.ID)" title="Forfeit Loss">FL, 7-0</a>
                    }
                    else
                    {
                        <a href="/Game/@(g.ID)" title="Forfeit Win">FW, 7-0</a>
                    }
                }
                else
                {
                        <a href="/Game/@(g.ID)"><small>@g.Status?.Name</small></a>
                }
                    </td>
                </tr>
            }
        </table>
</div>
