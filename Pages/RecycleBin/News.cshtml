@page
@inject IConfiguration config
@model RecycleBinNewsModel
@{
    var siteName = config["Site:Name"] ?? string.Empty;
    var shortName = config["Site:ShortName"] ?? string.Join(string.Empty, siteName.Split(' ').Select(w => w[0]));
    ViewData["Title"] = $"{shortName} » Recycle Bin (News)";
}
<div class="row recycle-bin-news">
    <div class="section">
        <h1>Recycle Bin</h1>
        <h2>News</h2>
@foreach(var news in Model.News) {
        @await Html.PartialAsync("_HomepageNewsPartial", news, new ViewDataDictionary(ViewData) { { "permissions", Model.Permissions }});
}
    </div>
</div>