@page "{id:int}/{mode?}"
@inject IConfiguration config
@model GameModel
@{
    var siteName = config["Site:Name"] ?? string.Empty;
    var shortName = config["Site:ShortName"] ?? string.Join(string.Empty, siteName.Split(' ').Select(w => w[0]));
    ViewData["Title"] = $"{shortName} » {Model.Game?.VisitingTeam?.Abbreviation}@{Model.Game?.HostTeam?.Abbreviation} ({Model.Game?.Date.ToString("MMM d, yyyy")})";
}
@if (Model.Mode == GameModel.PageMode.View) {
<partial name="_GameViewPartial" model="Model" />
}
else if (Model.Mode == GameModel.PageMode.Edit) {
<partial name="_GameEditPartial" model="Model" />
}
else if (Model.Mode == GameModel.PageMode.EditNew) {
<partial name="_GameEditNewPartial" model="Model" />
}