@page "{year:int?}"
@inject IConfiguration config
@model StandingsModel
@{
    var siteName = config["Site:Name"] ?? string.Empty;
    var shortName = config["Site:ShortName"] ?? string.Join(string.Empty, siteName.Split(' ').Select(w => w[0]));
    var username = string.Empty;
    if (User.Identity is not null) {
        username = User.Identity.Name;
    }
    ViewData["Title"] = $"{shortName} » Standings ({Model.CurrentSeason?.Name})";
}
<div class="row">
    <div class="section standings-section desktop-only">
        <h1>@Model.CurrentSeason?.Name</h1>
        <partial name="_StandingsTableFull" model="Model.Standings" />
    </div>
    <div class="section standings-section mobile-only">
        <h1>@Model.CurrentSeason?.Name</h1>
        <partial name="_StandingsTableFullMobile" model="Model.Standings" />
    </div>
</div>