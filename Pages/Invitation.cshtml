@page "{id:int?}"
@inject IConfiguration config
@model InvitationModel
@{
    var siteName = config["Site:Name"] ?? string.Empty;
    var shortName = config["Site:ShortName"] ?? string.Join(string.Empty, siteName.Split(' ').Select(w => w[0]));
    ViewData["Title"] = $"{shortName} » Invitation Form";
}
<div class="row">
    <div class="section invitation">
        <h1>@(Model.Form!.IsNewInvitation ? "New" : "Edit") Invitation</h1>
        <form method="post" id="form" class="invitation-form">
            <input type="hidden" id="PlayerExists" asp-for="Form!.PlayerExists" />
            <input type="hidden" id="UserExists" asp-for="Form!.UserExists" />
            <div class="section-row">
                <div>
                    <p>Select Team</p>
                    <input type="hidden" id="TeamID" asp-for="Form!.TeamID" />
                    <div class="team-selector">
    @foreach(var team in Model.Teams) {
        var enabled = Model.Form.IsNewInvitation && 
            (Model.Permissions["Webmaster"] || Model.Permissions["Executive"] || Model.Permissions.ContainsKey(team.FullName));
        var classes = new List<String>();
        if (team.ID == Model.Form.TeamID) {
            classes.Add("team-selected");
        }
        if (!enabled) {
            classes.Add("team-disabled");
        }
                        <div id="team-selector-@team.ID" 
                            onclick='@(enabled ? "updateTeam(" + team.ID + ")" : String.Empty)'
                            class='@(String.Join(" ", classes))'>
                            <partial name="_TeamLogoSmall" model="team" />
                        </div>
    }
                    </div>
                </div>
            </div>
            <div class="section-row invitation-form-main">
                <div class="invitation-form-player">
                    <h2>Player</h2>
                    <div>
                        <div class="section-row">
                            <i>Note: Leave this blank to create a non-player user!</i>
                        </div>
                        <div class="section-row invitation-form-player-name">
                            <div>
                                <label for="FirstName">First Name</label><input type="text" id="FirstName" asp-for="Form!.FirstName" /> 
                            </div>
                            <div>
                                <label for="LastName">Last Name</label><input type="text" id="LastName" asp-for="Form!.LastName" />
                            </div>
                        </div>
                        <div class="section-row">
                            <div><p>Number</p>
                                <input type="hidden" id="PlayerNumber" asp-for="Form!.Number" />
                                <div class="number-selector">
    @for(int i = 1; i < 100; i++) {
                                    <div id="number-selector-@(i)" onclick="updateNumber('@i')">
                                        <i class="fas fa-tshirt"></i>
                                        <div class="number">@(i)</div>
                                    </div>
    }
                                    <div id="number-selector-00" onclick="updateNumber('00')">
                                        <i class="fas fa-tshirt"></i>
                                        <div class="number">00</div>
                                    </div>
                                </div>
                            </div>
                            <div>
                                <label for="Status">Status</label><select id="StatusSelector" 
                                    size="@Model.InvitationStatuses.Count"
                                    asp-for="Form!.StatusID"
                                    asp-items="@(new SelectList(Model.InvitationStatuses,"ID","Name"))"
                                ></select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="invitation-form-user">
                    <h2>User</h2>
                    <div class="section-row">
                        <div>
                            <label for="Emails">Emails</label><input type="text" id="Emails" asp-for="Form!.Emails"
                                disabled="@(Model.Form.UserExists)" />
    @if(Model.Form.UserExists) {
                            <p style="font-style: italic"><sup>(Managed by existing user)</sup></p>
    }
                        </div>
                    </div>
                    <div class="section-row">
                        <div>
                            <label for="EmergencyContactInfo">Alternate Contact Info</label><input type="text" id="EmergencyContactInfo" asp-for="Form!.EmergencyContactInfo" />
                        </div>
                    </div>
                    <div class="section-row">
                        <div class="invitation-roles">
                            <p>Roles</p>
                            <div><input type="checkbox" id="Webmaster" asp-for="Form!.IsWebmaster" /><label for="Webmaster">Webmaster</label></div>
                            <div><input type="checkbox" id="Executive" asp-for="Form!.IsExecutive" /><label for="Executive">Executive</label></div>
                            <div><input type="checkbox" id="Manager" asp-for="Form!.IsManager" /><label for="Manager">Manager</label></div>
                            <div><input type="checkbox" id="Scorer" asp-for="Form!.IsScorer" /><label for="Scorer">Scorer</label></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="section-row">
                <button type="submit">@(Model.Form.IsNewInvitation ? "Create" : "Update")</button>
            </div>
            <div class="section-row">
                <div id="error-text"></div>
            </div>
        </form>
    </div>
</div>
<script src="https://code.jquery.com/jquery-3.5.0.min.js" integrity="sha256-xNzN2a4ltkB44Mc/Jz3pT4iU1cmeR0FkXs4pru/JxaQ=" crossorigin="anonymous"></script>
<script src="~/js/jquery.unobtrusive-ajax.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.1/dist/jquery.validate.min.js"></script>
<link rel="stylesheet" href="~/css/selectize.css" />
<link rel="stylesheet" href="~/css/selectize.default.css" />
<script src="~/js/selectize.js"></script>
<script src="~/js/invitation.js"></script>