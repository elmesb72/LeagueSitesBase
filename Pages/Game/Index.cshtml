@page "{id}"
@inject IConfiguration config
@model GameModel
@{
    var siteName = config["Site:Name"] ?? string.Empty;
    var shortName = config["Site:ShortName"] ?? string.Join(string.Empty, siteName.Split(' ').Select(w => w[0]));
    ViewData["Title"] = $"{shortName} » {Model.Game?.VisitingTeam?.Abbreviation}@{Model.Game?.HostTeam?.Abbreviation} ({Model.Game?.Date.ToString("MMM d, yyyy")})";
}
<div class="row game-row">
    <div class="inner-row">
        <div class="section game-team">
            <div><img src="/images/teams/@(Model.Game?.VisitingTeam?.ID)-md.webp"></div>
            <div>@Model.Records?[Model.Game?.VisitingTeam!].ToString()</div>
        </div>
        <div class="section game-header">
    @if (Model.Permissions.Any(p => new List<String> { 
        "Webmaster", 
        "Executive", 
        Model.Game?.HostTeam?.Abbreviation + "-Manager", 
        Model.Game?.HostTeam?.Abbreviation + "-Scorer", 
        Model.Game?.VisitingTeam?.Abbreviation + "-Manager", 
        Model.Game?.VisitingTeam?.Abbreviation + "-Scorer" 
        }.Contains(p))) {
            <div class="game-edit-link"><a href="/Game/Edit/@(Model.Game?.ID)">Edit Game / Submit Score</a></div>
    }
    @if (Model.Game?.Status?.Name == "Played") {
            <div class="game-matchup">@Model.Game.VisitingTeam?.Name @(Model.Game.ScoreVisitor), @Model.Game.HostTeam?.Name @(Model.Game.ScoreHost)</div>
    }
    else if (Model.Game?.Status?.Name.StartsWith("Forfeit") ?? false) {
        var forfeitingTeam = (Model.Game.Status.Name == "Forfeit (Home)" ? Model.Game.HostTeam : Model.Game.VisitingTeam);
        // TODO - add forfeit rules to site configuration
            <div class="game-matchup">@Model.Game.VisitingTeam?.Name @(Model.Game.VisitingTeam == forfeitingTeam ? "0" : "7"), @Model.Game.HostTeam?.Name @(Model.Game.HostTeam == forfeitingTeam ? "0" : "7")</div>
    }
    else {
            <div class="game-matchup">@Model.Game?.VisitingTeam?.Name @@ @Model.Game?.HostTeam?.Name</div>
    }
            <div class="game-time">@Model.Game?.Date.ToString("h:mm tt") EDT • @Model.Game?.Date.ToString("MMMM d, yyyy")</div>
            <div class="game-location">@Model.Game?.Location?.FormalName • @(Model.Game?.Location?.City)</div>
        </div>
        <div class="section game-team">
            <div><img src="/images/teams/@(Model.Game?.HostTeam?.ID)-md.webp"></div>
            <div>@Model.Records?[Model.Game?.HostTeam!].ToString()</div>
        </div>
    </div>
</div>
    
@if (Model.Game?.Status?.Name == "Upcoming") {
<div class="row">
    <div class="section game-upcoming">
        This game has not yet been played or scored. 
    </div>
</div>
}
