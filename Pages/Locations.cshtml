@page
@inject IConfiguration config
@model LocationsModel
@{
    var siteName = config["Site:Name"] ?? string.Empty;
    var shortName = config["Site:ShortName"] ?? string.Join(string.Empty, siteName.Split(' ').Select(w => w[0]));
    ViewData["Title"] = $"{shortName} » League History";
    var key = config["APIKeys:GoogleMaps"] ?? string.Empty;
    int i=0;
}
@foreach (var city in Model.Locations.GroupBy(p => p.City)) {
<div class="row location-row">
    <div class="section">
        <h1>@city.First().City</h1>
    @foreach (var location in Model.Locations.Where(p => p.City == city.First().City).GroupBy(p => p.FormalName)) {
        i++;
        <div class="inner-row">
        @if(i%2 == 0) {
            <div class="subsection location-details location-details-left">
                <iframe class="location-map" style="border:0" loading="lazy" allowfullscreen src="https://www.google.com/maps/embed/v1/place?q=place_id:@(location.First().MapsPlaceID)&maptype=satellite&key=@(key)"></iframe>
            </div>
        }
            <div class="subsection location-games">
        @foreach (var diamond in Model.Locations.Where(p => p.City == city.First().City && p.FormalName == location.First().FormalName)) {
            var recentGames = diamond.Games.Where(g => g.Status?.Name == "Played").OrderBy(g => Math.Abs(g.Date.Subtract(DateTime.Now).TotalDays)).Take(5);
            var upcomingGames = diamond.Games.Where(g => g.Status?.Name != "Played" && g.Date.Date >= DateTime.Today.Date).OrderBy(g => Math.Abs(g.Date.Subtract(DateTime.Now).TotalDays)).Take(5);
            <h2 id="@(diamond.Name)">@diamond.Name</h2>
            @if(recentGames.Count() > 0 || upcomingGames.Count() > 0) {
                @if(recentGames.Count() > 0) {
                <p class="location-diamond-subtitle">Recent Games</p>
                <ul class="location-games-list">
                    @foreach (var game in recentGames) {
                    <li>@game.Date.ToString("MMM dd, yyyy, h:mm tt"): @game.VisitingTeam?.FullName (@game.ScoreVisitor) @@ @game.HostTeam?.FullName (@game.ScoreHost)</li>
                    }
                <br />
                </ul>
                }
                @if(upcomingGames.Count() > 0) {
                <p class="location-diamond-subtitle">Upcoming Games</p>
                <ul class="location-games-list">
                    @foreach (var game in upcomingGames) {
                    <li>@game.Date.ToString("MMM dd, yyyy, h:mm tt"): @game.VisitingTeam?.FullName @@ @game.HostTeam?.FullName</li>
                    }
                </ul>
                <br />
                }
            }
            else {
                <p>There are no games that have been played here recently, nor are there currently any planned upcoming games.</p>
            }
                <br />
        }
            </div>
        @if(i%2 == 1) {
            <div class="subsection location-details location-details-right">
                <iframe class="location-map" style="border:0" loading="lazy" allowfullscreen src="https://www.google.com/maps/embed/v1/place?q=place_id:@(location.First().MapsPlaceID)&maptype=satellite&key=@(key)"></iframe>
            </div>
        }
        </div>
    }
    </div>
</div>
}
