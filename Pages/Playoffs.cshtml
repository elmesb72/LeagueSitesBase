@page "{year:int?}"
@inject IConfiguration config
@using System.Linq
@model PlayoffsModel
@{
    var siteName = config["Site:Name"] ?? string.Empty;
    var shortName = config["Site:ShortName"] ?? string.Join(string.Empty, siteName.Split(' ').Select(w => w[0]));
    ViewData["Title"] = $"{shortName} » {Model.CurrentSeason?.Year} Playoffs";
}
<div class="row">
    <div class="section playoff-section">
        <h1>@Model.CurrentSeason?.Year Playoffs</h1>
@if (Model.Playoffs != null && Model.Playoffs.Tournaments.Any())
{
        <div class="tournament">
    @foreach (var bracket in Model.Playoffs.Tournaments.First().Brackets)
    {
            <div class="tournament-bracket">
                <div class="tournament-bracket-name">@bracket.Name Bracket</div>
                <div class="tournament-bracket-rounds">
        @{
            int roundNum = 1;
        }
        @foreach (var round in bracket.Rounds)
        {
                    <div class="tournament-round round-@(roundNum)">
                        <div class="tournament-round-name">@round.Name</div>
            @foreach (var series in round.Series)
            {
                        <div class="tournament-series">
                            <div class="tournament-series-number">@series.Number</div>
                            <div class="tournament-series-matchup">
                @if (series.Spots.Item1.Team != null)
                {
                                <div class="tournament-series-team @(series.Winner != null && series.Winner == series.Spots.Item1.Team ? "tournament-series-winner" : "")"><a href="/Team/@(series.Spots.Item1.Team.Abbreviation)"><img src="/images/teams/@(series.Spots.Item1.Team.ID)-sm.webp" height="28"><span class="tournament-series-team-name">@(series.Spots.Item1.Team.Name)</span><sup>@(Model.Seeds?.Keys.ToList().IndexOf(series.Spots.Item1.Team)+1)</sup></a></div>
                }
                else if (series.Spots.Item1.Source == 'w')
                {
                                <div class="tournament-series-team"><img src="/images/teams/10-sm.webp" height="28"><span class="tournament-series-team-name">Winner of @series.Spots.Item1.Seed</span></div>
                }
                else if (series.Spots.Item1.Source == 'l')
                {
                                <div class="tournament-series-team"><img src="/images/teams/10-sm.webp" height="28"><span class="tournament-series-team-name">Loser of @series.Spots.Item1.Seed</span></div>
                }
                else if (series.Spots.Item1.Source == 'r')
                {
                                <div class="tournament-series-team"><img src="/images/teams/10-sm.webp" height="28"><span class="tournament-series-team-name">#@series.Spots.Item1.Seed remaining</span></div>
                }
                @if (series.Spots.Item2.Team != null)
                {
                                <div class="tournament-series-team @(series.Winner != null && series.Winner == series.Spots.Item2.Team ? "tournament-series-winner" : "")"><a href="/Team/@(series.Spots.Item2.Team.Abbreviation)"><img src="/images/teams/@(series.Spots.Item2.Team.ID)-sm.webp" height="28"><span class="tournament-series-team-name">@(series.Spots.Item2.Team.Name)</span><sup>@(Model.Seeds?.Keys.ToList().IndexOf(series.Spots.Item2.Team)+1)</sup></a></div>
                }
                else if (series.Spots.Item2.Source == 'w')
                {
                                <div class="tournament-series-team"><img src="/images/teams/10-sm.webp" height="28"><span class="tournament-series-team-name">Winner of @series.Spots.Item2.Seed</span></div>
                }
                else if (series.Spots.Item2.Source == 'l')
                {
                                <div class="tournament-series-team"><img src="/images/teams/10-sm.webp" height="28"><span class="tournament-series-team-name">Loser of @series.Spots.Item2.Seed</span></div>
                }
                else if (series.Spots.Item2.Source == 'r')
                {
                                <div class="tournament-series-team"><img src="/images/teams/10-sm.webp" height="28"><span class="tournament-series-team-name">#@series.Spots.Item2.Seed remaining</span></div>
                }
                            </div>
                        </div>
            }
                    </div>
            roundNum++;
        }
                </div>
            </div>
    }
        </div>
    @foreach (var roundrobin in Model.Playoffs.Tournaments.First().RoundRobins)
    {
        <div class="round-robin">
            <h2>@roundrobin.Name Standings</h2>
            <partial name="_StandingsTableFull" model="roundrobin.Standings" />
        </div>
    }
    @foreach (var round in Model.Playoffs.Tournaments.First().Brackets.SelectMany(b => b.Rounds).OrderBy(r => r.ID))
    {
        @foreach (var series in round.Series)
        {
            var results = series.GetResults();
            @if (series.Spots.Item1.Team == null || series.Spots.Item2.Team == null)
            {
                continue;
            }
        <div class="tournament-items-series">
            <h2>#@(Model.Seeds?.Keys.ToList().IndexOf(series.Spots.Item1.Team)+1) @series.Spots.Item1.Team.Name 
                vs #@(Model.Seeds?.Keys.ToList().IndexOf(series.Spots.Item2.Team)+1) @series.Spots.Item2.Team.Name</h2>
            @if (series.Winner != null)
            {
            <h3>@series.Winner.FullName win @(results.Values.First().Wins)-@(results.Values.Last().Wins)</h3>
            }
            else
            {
                @if (!results.Values.Any())
                {
                <h3>Series tied 0-0</h3>
                }
                else if (results.Values.First().Wins == results.Values.Last().Wins)
                {
                <h3>Series tied @(results.Values.First().Wins)-@(results.Values.Last().Wins)</h3>
                }
                else
                {
                <h3>@results.Keys.First().FullName lead @(results.Values.First().Wins)-@(results.Values.Last().Wins)</h3>
                }
            }
            <div class="tournament-items-games">
            @foreach (var game in series.Games)
            {
                <div class="tournament-items-game">
                    <div class="tournament-items-game-number">
                @if (game.Game != null) {
                        <a href="/Game/@game.Game.ID"><b>Gm @game.GameNumber</b><br />
                        <span class="tournament-items-game-date desktop-only">@Html.Raw(game.Game.Date.ToString("ddd MMM dd, h:mm tt"))</span>
                        <span class="tournament-items-game-date mobile-only">@Html.Raw(game.Game.Date.ToString("MMM d<br />h:mm tt"))</span></a>
                }
                else
                {
                        <b>Gm @game.GameNumber</b><br />
                        <span class="tournament-items-game-tbd desktop-only">(Date TBD)</span>
                        <span class="tournament-items-game-tbd mobile-only">(TBD)</span>
                }
                    </div>
                    <div class="tournament-items-game-location">
                @if(game.Game != null) {
                        <a href="/Locations/#@(game.Game.Location?.Name)">@game.Game.Location?.Name</a>
                }
                else
                {
                        <span class="tournament-items-game-tbd">(Location TBD)</span>
                }
                    </div>
                    <div class="tournament-items-game-team">
                @if (game.Game != null) {
                    @if (game.Game.Status?.Name == "Upcoming")
                    {
                        <a href="/Team/@(game.Game.VisitingTeam?.Abbreviation)"><img src="/images/teams/@(game.Game.VisitingTeamID)-md.webp" height="75" width="75">@game.Game.VisitingTeam?.Location</a>
                    }
                    else if (game.Game.Status?.Name == "Played")
                    {
                            var winner = (game.Game.ScoreHost > game.Game.ScoreVisitor ? game.Game.HostTeam : game.Game.VisitingTeam);
                        <a class="tournament-items-game-winner" href="/Team/@(winner?.Abbreviation)">
                            <img src="/images/teams/@(winner?.ID)-md.webp" height="75" width="75">
                        @winner?.Location 
                        @(game.Game.ScoreHost > game.Game.ScoreVisitor ? game.Game.ScoreHost : game.Game.ScoreVisitor)
                        </a>
                    }
                }
                else
                {
                        var host = series.HostOrder[(int)(game.GameNumber)-1];
                    @if (host == 2)
                    {
                            <a href="/Team/@(series.Spots.Item1.Team.Abbreviation)"><img src="/images/teams/@(series.Spots.Item1.Team.ID)-md.webp" height="75" width="75">@series.Spots.Item1.Team.Location</a>
                    }
                    else
                    {
                            <a href="/Team/@(series.Spots.Item2.Team.Abbreviation)"><img src="/images/teams/@(series.Spots.Item2.Team.ID)-md.webp" height="75" width="75">@series.Spots.Item2.Team.Location</a>
                    }
                }
                    </div>
                    <div class="tournament-items-game-team">
                @if (game.Game != null) {
                    @if (game.Game.Status?.Name == "Upcoming")
                    {
                        <a href="/Team/@(game.Game.HostTeam?.Abbreviation)"><img src="/images/teams/@(game.Game.HostTeamID)-md.webp" height="75" width="75">@@@game.Game.HostTeam?.Location</a>
                    }
                    else if (game.Game.Status?.Name == "Played")
                    {
                        var loser = (game.Game.ScoreHost < game.Game.ScoreVisitor ? game.Game.HostTeam : game.Game.VisitingTeam);
                        <a class="tournament-items-game-loser" href="/Team/@(loser?.Abbreviation)">
                            <img src="/images/teams/@(loser?.ID)-md.webp" height="75" width="75">
                            @loser?.Location 
                            @(game.Game.ScoreHost < game.Game.ScoreVisitor ? game.Game.ScoreHost : game.Game.ScoreVisitor)
                        </a>
                    }
                }
                else
                {
                    var host = series.HostOrder[(int)(game.GameNumber)-1];
                    @if (host == 1)
                    {
                            <a href="/Team/@(series.Spots.Item2.Team.Abbreviation)"><img src="/images/teams/@(series.Spots.Item2.Team.ID)-md.webp" height="75" width="75">@@@series.Spots.Item2.Team.Location</a>
                    }
                    else
                    {
                            <a href="/Team/@(series.Spots.Item1.Team.Abbreviation)"><img src="/images/teams/@(series.Spots.Item1.Team.ID)-md.webp" height="75" width="75">@@@series.Spots.Item1.Team.Location</a>
                    }
                }
                    </div>
                    <div class="tournament-items-game-lead">
                    @{
                        var resultsToThisPoint = new Standings(series.Games.Where(g => g.Game != null && g.GameNumber <= game.GameNumber && g.Game.Status?.Name == "Played").Select(g => g.Game!));
                    }
                    @if (series.Format == "Best of")
                    {
                        @if (!resultsToThisPoint.Values.Any())
                        {
                        <span>&nbsp;</span>
                        //<span>Series tied 0-0</span>
                        }
                        else if(resultsToThisPoint.Values.First().Wins == resultsToThisPoint.Values.Last().Wins) // series tied
                        {
                        <span>Series tied @(resultsToThisPoint.Values.First().Wins)-@(resultsToThisPoint.Values.Last().Wins)</span>
                        }
                        else // series has a leader
                        {
                            var isWin = resultsToThisPoint.Values.First().Wins == Convert.ToInt32(Math.Ceiling(series.HostOrder.Length/2d)); // series is won
                        <span>@resultsToThisPoint.Keys.First().Name @(isWin ? "win" : "lead") @(resultsToThisPoint.Values.First().Wins)-@(resultsToThisPoint.Values.Last().Wins)</span>
                        }
                            
                    }
                    </div>
                </div>
            }
            </div>
        </div>
        }
    }
    /*@foreach (var roundrobin in Model.Playoffs.Tournaments.First().RoundRobins)
    {
        <div class="round-robin-games">
            <h2>@roundrobin.Name Games</h2>
        @foreach (var game in roundrobin.Games.Select(g => g.Game).OrderBy(g => g.Date))
        {
            <p>@game.Date</p>
            <partial name="_HomepageGamePartial" model="game" />
        }
        </div>
    }*/
}
else
{
        <div class="subsection no-playoffs">
            <p>The playoffs have not yet started for this season.</p>
        </div>
}
    </div>
</div>