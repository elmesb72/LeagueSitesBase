@page "{search?}/{year:int?}"
@inject IConfiguration config
@model TeamModel
@{
    var siteName = config["Site:Name"] ?? string.Empty;
    var shortName = config["Site:ShortName"] ?? string.Join(string.Empty, siteName.Split(' ').Select(w => w[0]));
}
@if(Model.Team != null) {
    ViewData["Title"] = $"{shortName} » {Model.Team.Location} {Model.Team.Name}";
<partial name="_TeamPartial" model="Model" />
}
else if (Model.Teams != null) {
    ViewData["Title"] = $"{shortName} » Team Search";
<div class="row">
    <div class="section">
        <h1>Search Results</h1>
        <p>Team "@Model.Search" is unclear</p>
        <p>(@Model.SearchResults)</p>
        <br />
    @foreach (var team in Model.Teams.OrderBy(t => t.FullName)) {
        <li><a href="/Team/@team.ID">@team.FullName</a></li>
    }
    </div>
</div>
}